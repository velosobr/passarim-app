<?xml version="1.0" encoding="utf-8"?>
<!-- Manifesto principal: o app, a permissão de internet e a tela de entrada. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet para falar com o BFF e baixar as fotos e os cantos. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- allowBackup=false: nada do app (favoritos, configurações) vai para o backup do Android. -->
    <!-- O tema inicial é o da splash; ao fechar a splash, o Android aplica o postSplashScreenTheme. -->
    <application
        android:name=".PassarimApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Passarim.Splash">
        <!-- A única Activity; o intent-filter MAIN/LAUNCHER a põe no menu de apps. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
